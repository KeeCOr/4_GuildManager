{
  "name": "guild-manager",
  "version": "1.5.0",
  "description": "Guild Manager desktop build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.stoic.guildmanager",
    "productName": "GuildManager",
    "copyright": "Copyright 2026 Stoic Entertainment",
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "GuildManager_v${version}_portable.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "../steam_appid.txt"
    ],
    "directories": {
      "output": "release"
    }
  },
  "optionalDependencies": {
    "steamworks.js": "^0.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.0.0"
  }
}
