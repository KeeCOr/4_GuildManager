  const hasTank    = partyClasses.includes('?꾩궗')
  const hasRogue   = partyClasses.includes('?꾩쟻')

  // ?깆쭅?? ?뚰떚 ?꾩썝 ?뚮났 ???щ쭩瑜????媛먯냼
  if (hasHealer) risk *= 0.65
  // ?꾩궗: 痍⑥빟 ?대옒???깆쭅?먃룸쭏踰뺤궗) ?곗꽑 蹂댄샇
  if (hasTank && merc.class !== '?꾩궗') {
    risk *= (merc.class === '?깆쭅?? || merc.class === '留덈쾿??) ? 0.65 : 0.82
  }
  // ?꾩쟻/沅곸닔: ?⑥젙 ?섏뒪?몄뿉???뚰떚 ?꾩썝 蹂댄샇
  if (quest.trapFocus && (hasRogue || partyClasses.includes('沅곸닔'))) risk *= 0.70

  // ?? 4. ?뚭퇋紐??뚰떚 ?섎꼸??? ?깃툒 臾닿?, ?ㅽ꺈 湲곕컲 ?
  if (partySize < 3) {
    // 吏??遺????媛쒖씤 ?앹〈?⑥뿉 ?곕씪 ?⑤꼸?곌? ?щ씪吏?    // ?앹〈??100?대㈃ ?⑤꼸???놁쓬, 0?대㈃ 理쒕? 2.0諛?    const survNorm = merc.stats.?앹〈??/ 100  // 0~1
    const backupPenalty = 1.0 + (1 - partySize / 3) * (1.2 - survNorm * 0.9)
    risk *= backupPenalty
  }

  // ?? 5. ?뚰떚 ?됯퇏 ?묒“??? ?믪쓣?섎줉 ?좉린???꾩닠 媛????
  const avgCoop = party.reduce((s, m) => s + m.traits.cooperation, 0) / partySize
  const coopFactor = Math.max(0.72, 1.25 - avgCoop / 65)
  risk *= coopFactor

  // ?? 6. 吏곸뾽蹂?怨좎쑀 ?щ쭩瑜??뱀꽦 ??????????????????????
  if (merc.class === '留덈쾿??) risk *= 1.40  // 怨듦꺽?β넁 ?앹〈?β넃
  if (merc.class === '?깆쭅??) risk *= 1.30  // ?꾪닾 痍⑥빟 (?꾩궗 ?숉뻾 ???꾪솕)
  if (merc.class === '?꾩궗')   risk *= 0.88

  // ?? 7. ?뚰떚 ???곷? ?꾨젰 ? 媛???쏀븳 ?좊떅??癒쇱? ?곕윭吏???
  // ?뚰떚 ?됯퇏 ?ㅽ슚 ?꾨젰 ?鍮????좊떅???쇰쭏???쏀븳媛瑜??щ쭩瑜좎뿉 諛섏쁺
  // relStrength < 1 ???됯퇏蹂대떎 ?쏀븿 ???щ쭩瑜?湲됱쬆
  // relStrength > 1 ???됯퇏蹂대떎 媛뺥븿 ???щ쭩瑜??꾨쭔 媛먯냼
  if (partySize >= 2) {
    const partyAvgEff = party.reduce((s, m) => s + effPowerVs(m, quest.element), 0) / partySize
    const mercEff = effPowerVs(merc, quest.element)
    const relStrength = mercEff / Math.max(1, partyAvgEff)
    // pow(1/rel, 0.75): rel=1.0 ??횞1.0, rel=0.5 ??횞1.68, rel=0.3 ??횞2.4, rel=1.5 ??횞0.74
    const relFactor = Math.max(0.65, Math.min(2.4, Math.pow(1 / Math.max(0.1, relStrength), 0.75)))
    risk *= relFactor
  }

  // ?? 7b. 耳誘??먯닔 蹂댁젙 ??????????????????????????????
  const chem = calcChemistryScore(party)
  if      (chem >= 80) risk *= 0.78
  else if (chem < 40)  risk *= 1.30
  else if (chem < 60)  risk *= 1.12

  // ?? 8. ?띿꽦 ?쇱튂/?곸꽦 ?щ쭩瑜?蹂댁젙 ??????????????????????
  const elemRel = elementRelation(merc.element, quest.element)
  if (elemRel === 'match')             risk *= 0.50
  else if (elemRel === 'advantage')    risk *= 0.85
  else if (elemRel === 'disadvantage') risk *= 1.15
  // ?? 9. ?⑥떆釉??щ쭩瑜?蹂댁젙 ??????????????????????????????
  risk *= passiveDeathMod(merc)

  return Math.min(0.98, Math.max(0.01, risk))
}

