  }

  // ?? 2. 媛쒖씤 ?앹〈???ㅽ꺈 (??긽 ?곸슜) ??????????????
  risk *= Math.max(0.28, 1 - (merc.stats.?앹〈??+ eqSurv(merc)) / 120)
  // ?? 2b. ?ш컖??而⑤뵒???⑤꼸???????????????????????
  if      (merc.condition < 20) risk *= 4.0
  else if (merc.condition < 35) risk *= 2.5
  else if (merc.condition < 50) risk *= 1.5

  // ?? 3. ?뚰떚 援ъ꽦 ?쒕꼫吏 ????????????????????????????
  const partyClasses = party.map(m => m.class)
