          if (Math.random() < calcMercDeathRisk(quest, merc, failParty)) {
            nextMercs = nextMercs.map(m => m.id === mid ? { ...m, status: '?곹샎' as const, room: '湲몃뱶留덉뒪?곕８' as const, hp: 0, condition: 0 } : m)
            deadIds.push(mid); fame = Math.max(0, fame - 2); batchDeaths++
            questLines.push(`?? ${merc.name} ?꾩궗 ???꾨Т 以?紐⑹닲???껋뿀?듬땲?? ?곹샎??湲몃뱶???⑥븘?덉뒿?덈떎. ?뫛+1`)
          } else {
          nextMercs = nextMercs.map(m => m.id === mid ? { ...m, status: '遺??, hp: Math.max(0, m.hp - 30) } : m)
          }
        }
        if (deadIds.length > 0) {
          morale = Math.max(0, morale - deadIds.length * 5)
        questLines.push(`?삍 ?숇즺瑜??껋? ?앹〈?먮뱾???ш린? 而⑤뵒?섏씠 ??섎맗?덈떎.`)
          const deadRacesFail = deadIds.map(did => nextMercs.find(d => d.id === did)?.race).filter(Boolean) as string[]
          nextMercs = nextMercs.map(m => {
