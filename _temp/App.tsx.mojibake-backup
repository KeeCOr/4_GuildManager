function calcMercDeathRisk(quest: Quest, merc: Mercenary, party: Mercenary[]): number {
  let risk = quest.deathRisk
  const partySize = party.length

  // ?? 0. ?뚰떚 ?꾨젰 vs ?붽뎄 ?꾨젰 ? ?꾨젰 遺議????щ쭩瑜?湲됱쬆 ??
  const totalPartyEff = party.reduce((s, m) => s + effPowerVs(m, quest.element), 0)
  const powerRatio = totalPartyEff / quest.difficulty
  if      (powerRatio < 0.4) risk *= 5.0   // ?ш컖???꾨젰 遺議? ?숈궡 ?섏?
  else if (powerRatio < 0.6) risk *= 3.0   // ?꾨젰 ?ш쾶 遺議?  else if (powerRatio < 0.8) risk *= 1.8   // ?꾨젰 遺議?  else if (powerRatio < 0.95) risk *= 1.2  // ?쎄컙 遺議?  else if (powerRatio >= 1.5) risk *= 0.6  // ?뺣룄???꾨젰: ?꾪뿕 媛먯냼

  // ?? 1. ?섏뒪??醫낅쪟蹂??붽뎄 ?λ젰移???????????????????
  // ?⑥젙 ?섏뒪?? ?꾩쟻쨌沅곸닔 ????앹〈???μ긽
  if (quest.trapFocus && canTrap(merc)) {
    risk *= Math.max(0.2, 1.8 - (merc.trap_disarm + eqTrap(merc)) / 25)
  } else if (quest.conditionDrain >= 20 && canTrap(merc)) {
    risk *= Math.max(0.45, 1.5 - (merc.trap_disarm + eqTrap(merc)) / 40)
  }
  // ?꾪닾??(deathRisk ??0.12): 怨듦꺽?μ씠 ??쑝硫??곸뿉寃??뺣룄??  if (quest.deathRisk >= 0.12) {
    const atkFactor = Math.max(0.55, 1.45 - (merc.stats.怨듦꺽??+ eqAtk(merc)) / 55)
    risk *= atkFactor
  }
  // ?κ린 ?먯젙??(duration ??4): ?앹〈?⑥씠 ?쒓컙???곕씪 蹂듬━濡?以묒슂?댁쭚
  if (quest.duration >= 4) {
